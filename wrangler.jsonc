{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "santa-killa",
  "compatibility_date": "2026-10-22",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "main": "worker/index.ts",
  "ratelimits": [
    {
      "name": "BOOKING_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 3,
        "period": 60
      }
    }
  ],
  "keep_vars": true,
  "vars": {
    "BOOKING_FROM": "reservas@santakillasurf.com"
  },
  // Activar después de verificar el correo de la escuela en Cloudflare:
  // "send_email": [{ "name": "BOOKING_EMAIL", "destination_address": "santakilla.surfschool@gmail.com" }]
}
